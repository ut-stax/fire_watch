rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Events collection - security logs
    // Validates required fields: source_ip, event_type, severity
    match /events/{document=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.source_ip is string
        && request.resource.data.event_type is string
        && request.resource.data.severity is string
        && request.resource.data.message is string;
      allow update, delete: if request.auth != null;
    }

    // Alerts collection - detected security issues
    match /alerts/{document=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.rule_name is string
        && request.resource.data.severity is string
        && request.resource.data.source_ip is string;
      allow update, delete: if request.auth != null;
    }

    // Block all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

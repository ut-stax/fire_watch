rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow authenticated users to read and write to events collection
    // Validates that required fields are present on write
    match /events/{document=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.source_ip is string
        && request.resource.data.event_type is string
        && request.resource.data.severity is string;
      allow update, delete: if request.auth != null;
    }

    // Allow authenticated users to read and write to alerts collection
    match /alerts/{document=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.rule_name is string
        && request.resource.data.severity is string
        && request.resource.data.source_ip is string;
      allow update, delete: if request.auth != null;
    }

    // Allow authenticated users to read and write to test_connection collection
    // (used for connectivity testing)
    match /test_connection/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Block all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
